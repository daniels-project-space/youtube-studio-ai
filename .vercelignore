# Keep the Vercel upload small — these are NOT part of the Next.js app build.
# (Hobby-plan deployments BLOCK when oversized; the repo otherwise carries ~38GB
#  of render output that the app does not need.)
output/
motion-graphics/
graphify-out/
test-fixtures/
# The production typecheck includes source-level diagnostic tests that import
# this tiny fixture module. Keep the fixture code available to Vercel without
# uploading the retained MP4/JSON diagnostic media.
!test-fixtures/
!test-fixtures/chess-replay/
!test-fixtures/chess-replay/fixture.ts
test-fixtures/chess-replay/*.mp4
test-fixtures/chess-replay/*.json
test-fixtures/chess-replay/README.md
.serena/
.agents/
.codex/
scripts/__pycache__/
.next/
*.log
# stray Windows temp-path artifacts
UsersdanieAppDataLocalTempt_*
