# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Python worker runtime cache
__pycache__/
*.pyc

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# convex
.convex
.env.local

# trigger.dev (local build/cache + lockfiles)
.trigger

# typescript
*.tsbuildinfo
next-env.d.ts

# motion-graphics (Remotion render project) — never commit deps or render outputs
/motion-graphics/node_modules
/motion-graphics/output
/motion-graphics/out/
/motion-graphics/public/
/motion-graphics/.cache
scripts/.yt-refresh-token.txt
scripts/__pycache__/

# Local agent/navigation state; never ship or review as application source.
/.agents/
/.codex/
/.serena/
graphify-out/

# dead-agent experiment render outputs (36GB) — never commit generated media
/output
motion-graphics/*.jpg
motion-graphics/*.png
motion-graphics/*.mp4
motion-graphics/*.gif
motion-graphics/*.mp3
motion-graphics/*.log
scripts/*.pyc
scripts/*.bak_torch

# Owner lock markers: a per-machine mirror of Convex, rebuilt by the sync timer.
# Committing them would let a stale checkout claim something is locked when the
# owner has already released it.
.locks/
