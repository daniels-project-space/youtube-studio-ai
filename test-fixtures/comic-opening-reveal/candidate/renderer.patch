+def reveal_panel(pg, pane, progress):
+    if pane is None or progress <= 0:
+        return None, None
+    progress = min(progress, 1.0)
+    x, y, w, h = pane["box"]
+    mask = pane["order2d"] <= progress
+    pg["world"][pg["PY"] + y:pg["PY"] + y + h, pg["PX"] + x:pg["PX"] + x + w][mask] = pane["art"][mask]
+    if progress >= 1.0:
+        return None, None
+    k = min(int(progress * len(pane["traj"])), len(pane["traj"]) - 1)
+    return (pg["PX"] + x + pane["traj"][k, 0], pg["PY"] + y + pane["traj"][k, 1]), pane
+
